{
  "name": "swift-todo",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "description": "A quick to-do list in your browser toolbar, synced with your browser account.",
  "author": "Oussama Essamadi",
  "license": "MIT",
  "homepage": "https://github.com/eoussama/swift-todo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/swift-todo.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/swift-todo/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "lint": "dx lint",
    "fix": "dx fix",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors=false",
    "check": "pnpm audit && pnpm lint && pnpm typecheck && pnpm test && pnpm build:all && pnpm lint:firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@eoussama/core": "^0.1.2"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.1.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint-plugin-svelte": "^3.24.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
